---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, postsInSeries, type Series } from "../../lib/content";
import { getLocalizedPath, type Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
  series: Series;
}

const { locale, series } = Astro.props;
const posts = postsInSeries(await getPublishedPosts(), series.id);
const { Content } = await render(series);
---

<BaseLayout title={series.data.title} description={series.data.description} locale={locale}>
  <header class="collection-heading">
    <h1>{series.data.title}</h1>
    <p>{series.data.description}</p>
  </header>
  <div class="prose collection-intro"><Content /></div>
  <ol class="series-posts">
    {posts.map((post, index) => (
      <li>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <a href={getLocalizedPath(locale, "/posts/" + post.id + "/")}>
          {post.data.title}
        </a>
        <span>→</span>
      </li>
    ))}
  </ol>
</BaseLayout>
