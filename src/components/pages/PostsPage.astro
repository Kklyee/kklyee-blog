---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../posts/PostList.astro";
import { getPublishedPosts, getSeriesMap } from "../../lib/content";
import { messages, type Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
const posts = await getPublishedPosts();
const seriesMap = await getSeriesMap();
---

<BaseLayout title={t.posts.title} description={t.posts.description} locale={locale}>
  <header class="page-heading"><p>{t.posts.eyebrow}</p><h1>{t.posts.title}</h1></header>
  <PostList posts={posts} seriesMap={seriesMap} locale={locale} />
</BaseLayout>
