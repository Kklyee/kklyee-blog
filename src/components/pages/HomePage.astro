---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../posts/PostList.astro";
import { getPublishedPosts, getSeriesMap } from "../../lib/content";
import { messages, type Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = messages[locale];
const posts = await getPublishedPosts();
const seriesMap = await getSeriesMap();
const postsPerPage = 6;
const totalPages = Math.max(1, Math.ceil(posts.length / postsPerPage));
---

<BaseLayout bodyClass="home-page" description={t.siteDescription} locale={locale}>
  <section class="intro" aria-labelledby="intro-title">
    <h1 id="intro-title">
      <span>Kklyee</span>
      <span><em>.dev</em></span>
    </h1>
    <p>{t.home.tagline}</p>
  </section>

  <section class="latest" aria-labelledby="latest-title">
    <PostList posts={posts} seriesMap={seriesMap} postsPerPage={postsPerPage} locale={locale} />
  </section>

  <nav
    class="floating-pagination"
    aria-label={t.home.pagination}
    data-pagination
    data-page-size={postsPerPage}
    data-total-pages={totalPages}
  >
    <button
      class="floating-pagination__button"
      type="button"
      data-page-previous
      aria-label={t.home.previousPage}
      disabled
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m15 18-6-6 6-6"></path>
      </svg>
      <span>{t.home.previousPage}</span>
    </button>
    <span class="floating-pagination__status" aria-live="polite" data-page-status>1 / {totalPages}</span>
    <button
      class="floating-pagination__button"
      type="button"
      data-page-next
      aria-label={t.home.nextPage}
      disabled={totalPages === 1}
    >
      <span>{t.home.nextPage}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </button>
  </nav>
</BaseLayout>

<script>
  const setupPagination = () => {
    const pagination = document.querySelector<HTMLElement>("[data-pagination]");
    if (!pagination || pagination.dataset.ready === "true") return;

    pagination.dataset.ready = "true";
    const posts = [...document.querySelectorAll<HTMLElement>("[data-post-index]")];
    const postList = document.querySelector<HTMLElement>(".post-list");
    const previous = pagination.querySelector<HTMLButtonElement>("[data-page-previous]");
    const next = pagination.querySelector<HTMLButtonElement>("[data-page-next]");
    const status = pagination.querySelector<HTMLElement>("[data-page-status]");
    const pageSize = Number(pagination.dataset.pageSize ?? 6);
    const totalPages = Number(pagination.dataset.totalPages ?? 1);

    if (!previous || !next || !status) return;

    const pageFromUrl = () => {
      const requestedPage = Number(new URL(window.location.href).searchParams.get("page") ?? 1);
      return Number.isInteger(requestedPage) ? Math.min(Math.max(requestedPage, 1), totalPages) : 1;
    };

    const renderPage = (page: number, updateUrl = false, animate = false) => {
      const firstPost = (page - 1) * pageSize;
      const lastPost = firstPost + pageSize;
      const visiblePosts = posts.filter((_, index) => index >= firstPost && index < lastPost);

      posts.forEach((post) => post.classList.remove("post-row--entering"));
      posts.forEach((post, index) => {
        post.hidden = index < firstPost || index >= lastPost;
      });

      if (animate && postList) {
        void postList.offsetWidth;
        visiblePosts.forEach((post) => post.classList.add("post-row--entering"));
      }
      previous.disabled = page === 1;
      next.disabled = page === totalPages;
      status.textContent = page + " / " + totalPages;

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (page === 1) url.searchParams.delete("page");
        else url.searchParams.set("page", String(page));
        window.history.pushState({ page }, "", url);
      }

      pagination.dataset.currentPage = String(page);
    };

    previous.addEventListener("click", () => {
      renderPage(Math.max(1, Number(pagination.dataset.currentPage) - 1), true, true);
    });
    next.addEventListener("click", () => {
      renderPage(Math.min(totalPages, Number(pagination.dataset.currentPage) + 1), true, true);
    });
    window.addEventListener("popstate", () => renderPage(pageFromUrl(), false, true));

    renderPage(pageFromUrl());
  };

  document.addEventListener("astro:page-load", setupPagination);
  setupPagination();
</script>
