---
interface Props {
  animated?: boolean;
  class?: string;
  locale?: import("../../lib/i18n").Locale;
}

const { animated = true, class: className = "", locale = "zh-cn" } = Astro.props;
const suffix = animated ? "-animated" : "";
const homeHref = locale === "en" ? "/en/" : "/";
---

<a class={`brand-logo ${className}`} href={homeHref} aria-label={locale === "en" ? "Kklyee.top home" : "Kklyee.top 首页"}>
  <img
    class="brand-logo__light"
    src={`/brand/logo-light${suffix}.svg`}
    alt="Kklyee.top"
    width="390"
    height="112"
  />
  <img
    class="brand-logo__dark"
    src={`/brand/logo-dark${suffix}.svg`}
    alt=""
    width="390"
    height="112"
    aria-hidden="true"
  />
</a>
