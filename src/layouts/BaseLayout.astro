---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MermaidRenderer from "../components/posts/MermaidRenderer.astro";
import { ClientRouter, fade } from "astro:transitions";
import { getLocaleFromPath, getLocalizedPath, messages, type Locale } from "../lib/i18n";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  type?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  locale?: Locale;
}

const {
  title = "Kklyee.top",
  description,
  bodyClass,
  type = "website",
  publishedAt,
  updatedAt,
  schema,
  locale: localeProp,
} = Astro.props;
const locale = localeProp ?? getLocaleFromPath(Astro.url.pathname);
const t = messages[locale];
const pageDescription = description ?? t.siteDescription;
const pageTitle = title === "Kklyee.top" ? title : `${title} · Kklyee.top`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL(getLocalizedPath(locale, "/"), Astro.site);
const authorUrl = new URL(getLocalizedPath(locale, "/about/"), Astro.site);
const authorId = new URL(getLocalizedPath(locale, "/about/") + "#person", Astro.site).href;
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": siteUrl.href,
  name: "Kklyee.top",
  url: siteUrl.href,
  inLanguage: t.htmlLang,
  description: pageDescription,
  author: {
    "@type": "Person",
    "@id": authorId,
    name: "Kklyee",
    url: authorUrl.href,
  },
  publisher: { "@id": authorId },
};
const schemas = [websiteSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang={t.htmlLang} transition:animate={fade({ duration: "0.35s" })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Kklyee" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Kklyee.top RSS" href={new URL("/rss.xml", Astro.site)} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Kklyee.top" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:url" content={canonicalUrl} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    {type === "article" && <meta property="article:author" content={authorUrl.href} />}
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" sizes="any" />
    <title>{pageTitle}</title>
    {
      schemas.map((item) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KC6XZLBDGL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }

      gtag("js", new Date());
      gtag("config", "G-KC6XZLBDGL", { send_page_view: false });

      document.addEventListener("astro:page-load", () => {
        gtag("event", "page_view", {
          page_title: document.title,
          page_location: window.location.href,
          page_path: window.location.pathname,
        });
      });
    </script>
    <ClientRouter />
    <script is:inline>
      (() => {
        const applySavedTheme = (targetDocument) => {
          const savedTheme = localStorage.getItem("kklyee-theme");
          if (savedTheme === "light" || savedTheme === "dark") {
            targetDocument.documentElement.dataset.theme = savedTheme;
          }
        };

        applySavedTheme(document);

        if (!window.__kklyeeThemeNavigationInitialized) {
          window.__kklyeeThemeNavigationInitialized = true;
          document.addEventListener("astro:before-swap", (event) => {
            applySavedTheme(event.newDocument);
          });
        }

        if (!window.__kklyeeScrollNavigationInitialized) {
          window.__kklyeeScrollNavigationInitialized = true;
          let previousScrollBehavior = "";
          document.addEventListener("astro:before-preparation", () => {
            previousScrollBehavior = document.documentElement.style.scrollBehavior;
            document.documentElement.style.scrollBehavior = "auto";
          });
          document.addEventListener("astro:after-swap", () => {
            if (!window.location.hash) {
              window.scrollTo({ left: 0, top: 0, behavior: "instant" });
            }
            document.documentElement.style.scrollBehavior = previousScrollBehavior;
          });
        }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <Header />
    <main class="page-shell">
      <slot />
    </main>
    <Footer />
    <MermaidRenderer />
  </body>
</html>
