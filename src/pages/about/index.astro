---
import BaseLayout from "../../layouts/BaseLayout.astro";

const focuses = ["AI Agent Engineering", "LLM Application Engineering", "AI Coding"];

const selectedWork = [
  {
    name: "mynano-agent",
    description: "TypeScript AI Agent Runtime",
    meta: "Runtime / Tools / Context",
    href: "https://github.com/Kklyee/mynano-agent",
  },
  {
    name: "KklyeeNook",
    description: "Desktop pet with AI Agent",
    meta: "Agent / Application / Desktop",
    href: "https://github.com/Kklyee/KklyeeNook",
  },
];
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Kklyee",
  url: new URL("/about/", Astro.site).href,
  jobTitle: "全栈开发者",
  description: "专注 AI Agent、LLM 应用工程与 AI Coding。",
  sameAs: ["https://github.com/Kklyee"],
  knowsAbout: focuses,
};
---

<BaseLayout
  title="关于"
  description="Kklyee，全栈开发者，专注 AI Agent 与 LLM 应用工程。"
  schema={personSchema}
>
  <article class="about">
    <header class="about-hero">
      <p class="breadcrumb"><span>ABOUT</span><i>/</i>Kklyee</p>

      <div class="about-hero__intro">
        <h1>
          <span class="hero-typewriter" data-text="你好，我是 Kklyee">
            <span class="hero-typewriter__text">你好，我是 Kklyee</span>
          </span>
        </h1>
        <p>
          <span class="typewriter" data-text="全栈开发者，专注 AI Agent 与 LLM 应用工程。">
            <span class="typewriter__text">全栈开发者，专注 AI Agent 与 LLM 应用工程。</span>
          </span>
        </p>
      </div>

      <div class="agent-map" aria-label="从模型能力到真实应用的 Agent 工程链路">
        <div class="agent-map__flow">
          <span>MODEL</span>
          <i class="agent-map__line" aria-hidden="true"></i>
          <span>CONTEXT</span>
          <b aria-hidden="true">—</b>
          <span>TOOLS</span>
          <b aria-hidden="true">—</b>
          <span>WORKFLOW</span>
        </div>
        <div class="agent-map__branch" aria-hidden="true"></div>
        <div class="agent-map__result">
          <strong>AGENT / APPLICATION</strong>
          <p>从模型能力，到真实应用。</p>
        </div>
      </div>
    </header>

    <section class="manifesto" aria-label="工作方法">
      <p>让模型、上下文与工具，在真实的软件系统中协同工作。</p>
      <span>BUILD / TEST / ITERATE</span>
    </section>

    <section class="focus" aria-labelledby="focus-title">
      <h2 id="focus-title">FOCUS / 03</h2>
      <ol>
        {focuses.map((focus, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <p>{focus}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="work" aria-labelledby="work-title">
      <h2 id="work-title">WORKS / 02</h2>
      <ol>
        {selectedWork.map((item, index) => (
          <li>
            <span class="work__number">{String(index + 1).padStart(2, "0")}</span>
            <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noreferrer" : undefined}>
              {item.name}
            </a>
            <p>{item.description}</p>
            <span class="work__meta">{item.meta}<i aria-hidden="true">↗</i></span>
          </li>
        ))}
      </ol>
    </section>
  </article>
</BaseLayout>

<style>
  .about {
    padding-top: clamp(4rem, 8vw, 6.7rem);
  }

  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(21rem, 0.85fr);
    grid-template-areas:
      "crumb crumb"
      "intro map";
    column-gap: clamp(3rem, 8vw, 8.5rem);
    row-gap: 2.6rem;
    padding-bottom: clamp(3.5rem, 6vw, 5rem);
  }

  .breadcrumb {
    grid-area: crumb;
    display: flex;
    gap: 0.8rem;
    margin: 0;
    color: var(--cobalt);
    font-size: 0.76rem;
    line-height: 1;
  }

  .breadcrumb i {
    font-style: normal;
  }

  .about-hero__intro {
    grid-area: intro;
  }

  .about-hero__intro h1 {
    margin: 0;
    color: var(--ink);
    font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: clamp(2.8rem, 4.2vw, 4.15rem);
    font-weight: 650;
    letter-spacing: 0.035em;
    line-height: 1.15;
  }

  .about-hero__intro p {
    margin: 2rem 0 0;
    color: var(--muted);
    font-size: 1.05rem;
    letter-spacing: 0.055em;
  }

  .hero-typewriter,
  .typewriter {
    display: inline-grid;
    max-width: 100%;
    vertical-align: bottom;
  }

  .hero-typewriter::before,
  .hero-typewriter__text,
  .typewriter::before,
  .typewriter__text {
    grid-area: 1 / 1;
    white-space: nowrap;
  }

  .hero-typewriter::before,
  .typewriter::before {
    content: attr(data-text);
    visibility: hidden;
  }

  .hero-typewriter__text {
    display: block;
    width: 0;
    overflow: hidden;
    border-right: 2px solid var(--cobalt);
    padding-right: 0.12em;
    animation:
      typewriter-reveal 1.8s steps(15, end) 0.15s forwards,
      hero-caret 2.05s step-end 0.15s forwards;
  }

  .typewriter__text {
    display: block;
    width: 0;
    overflow: hidden;
    border-right: 1px solid transparent;
    padding-right: 0.12em;
    animation:
      typewriter-reveal 2.5s steps(29, end) 2.25s forwards,
      typewriter-caret 0.75s step-end 2.25s infinite;
  }

  .agent-map {
    grid-area: map;
    align-self: center;
    padding-top: 0.7rem;
    text-align: center;
  }

  .agent-map__flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    color: var(--ink);
    font-size: 0.72rem;
    line-height: 1;
    white-space: nowrap;
  }

  .agent-map__flow b {
    font-weight: 300;
  }

  .agent-map__line {
    position: relative;
    width: 4.7rem;
    height: 1px;
    background: var(--cobalt);
  }

  .agent-map__line::after {
    content: "";
    position: absolute;
    top: 50%;
    right: 0;
    width: 0.56rem;
    height: 0.56rem;
    border-radius: 50%;
    background: var(--cobalt);
    transform: translate(50%, -50%);
  }

  .agent-map__branch {
    position: relative;
    width: 1px;
    height: 3.7rem;
    margin: 0.8rem 2.5rem 0 auto;
    background: var(--cobalt);
  }

  .agent-map__branch::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0.56rem;
    height: 0.56rem;
    border-radius: 50%;
    background: var(--cobalt);
    transform: translate(-50%, 50%);
  }

  .agent-map__result {
    margin-top: 0.95rem;
    margin-left: auto;
    width: 14.4rem;
  }

  .agent-map__result strong {
    font-size: 0.72rem;
    font-weight: 400;
  }

  .agent-map__result p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .manifesto {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.85rem 0;
    border-bottom: 1px solid var(--line);
  }

  .manifesto p {
    margin: 0;
    color: var(--ink);
    font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: clamp(1.18rem, 1.7vw, 1.52rem);
    letter-spacing: 0.02em;
  }

  .manifesto span,
  .focus h2,
  .work h2 {
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 400;
    letter-spacing: 0.035em;
  }

  .manifesto span {
    flex: none;
    color: var(--ink);
  }

  .focus h2,
  .work h2 {
    margin: 0;
    padding-top: 1.1rem;
  }

  .focus ol,
  .work ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .focus ol {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 0.35rem 0 1.55rem;
    border-bottom: 1px solid var(--line);
  }

  .focus li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.15rem;
    min-height: 3rem;
    padding: 0 0.8rem;
  }

  .focus li + li {
    border-left: 1px solid var(--line);
    padding-left: clamp(2.2rem, 6vw, 5.2rem);
  }

  .focus li span,
  .work__number {
    color: var(--ink);
    font-size: 1rem;
  }

  .focus li p {
    margin: 0;
    color: var(--ink);
    font-size: 0.92rem;
  }

  .work h2 {
    padding-bottom: 0.35rem;
  }

  .work li {
    display: grid;
    grid-template-columns: 2rem 15rem minmax(12rem, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.8rem;
    border-bottom: 1px solid var(--line);
  }

  .work li > a {
    color: var(--ink);
    font-size: 0.92rem;
    transition: color 0.18s ease;
  }

  .work li:first-child > a {
    color: var(--ink);
  }

  .work li > a:hover,
  .work li > a:focus-visible {
    color: var(--cobalt);
  }

  .work li p,
  .work__meta {
    margin: 0;
    color: var(--muted);
    font-size: 0.72rem;
  }

  .work__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    white-space: nowrap;
  }

  .work__meta i {
    color: var(--ink);
    font-size: 0.92rem;
    font-style: normal;
  }

  @media (max-width: 58rem) {
    .about-hero {
      grid-template-columns: 1fr;
      grid-template-areas: "crumb" "intro" "map";
      row-gap: 2rem;
    }

    .agent-map {
      max-width: 27rem;
      margin-left: auto;
    }

    .work li {
      grid-template-columns: 2rem 12rem 1fr;
    }

    .work__meta {
      grid-column: 2 / -1;
      padding-bottom: 0.9rem;
    }
  }

  @media (max-width: 43rem) {
    .about {
      padding-top: 3.2rem;
    }

    .about-hero__intro h1 {
      font-size: clamp(2.45rem, 11vw, 3.25rem);
      letter-spacing: -0.01em;
    }

    .about-hero__intro p {
      font-size: 0.95rem;
      line-height: 1.9;
    }

    .hero-typewriter::before,
    .hero-typewriter__text,
    .typewriter::before,
    .typewriter__text {
      white-space: normal;
    }

    .hero-typewriter__text,
    .typewriter__text {
      width: 100%;
      border-right: 0;
      animation: none;
    }

    .agent-map {
      width: 100%;
      overflow: hidden;
    }

    .agent-map__flow {
      justify-content: flex-start;
      gap: 0.4rem;
      font-size: 0.62rem;
    }

    .agent-map__line {
      width: 2.8rem;
    }

    .manifesto {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }

    .focus ol {
      grid-template-columns: 1fr;
      padding-block: 0.65rem;
    }

    .focus li {
      padding: 0.55rem 0;
    }

    .focus li + li {
      border-top: 1px solid var(--line);
      border-left: 0;
      padding-left: 0;
    }

    .work li {
      grid-template-columns: 2rem 1fr;
      gap: 0.15rem 0.75rem;
      padding: 0.85rem 0;
    }

    .work li p,
    .work__meta {
      grid-column: 2;
      padding: 0;
    }
  }

  @keyframes typewriter-reveal {
    to {
      width: 100%;
    }
  }

  @keyframes typewriter-caret {
    0%,
    100% {
      border-color: var(--cobalt);
    }

    50% {
      border-color: transparent;
    }
  }

  @keyframes hero-caret {
    25%,
    75%,
    100% {
      border-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-typewriter__text,
    .typewriter__text {
      width: 100%;
      border-right: 0;
      animation: none;
    }

  }
</style>
