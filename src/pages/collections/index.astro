---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, postsInSeries } from "../../lib/content";

const [seriesEntries, posts] = await Promise.all([getCollection("series"), getPublishedPosts()]);

const statusLabels = {
  planning: "准备中",
  writing: "连载中",
  complete: "已完结",
} as const;
---

<BaseLayout title="合集" description="按主题连续阅读 Kklyee.dev 的技术文章。">
  <section class="collections" aria-labelledby="collections-title">
    <h1 id="collections-title" class="sr-only">合集</h1>
    <ol class="collection-list">
      {seriesEntries.map((series, seriesIndex) => {
        const seriesPosts = postsInSeries(posts, series.id);
        const count = seriesPosts.length;

        return (
          <li class="collection-item">
            <article>
              <a class="collection-link" href={`/collections/${series.id}/`}>
                <div class="collection-copy">
                  <p class="collection-meta">
                    <span>{String(seriesIndex + 1).padStart(2, "0")}</span>
                    <span aria-hidden="true">/</span>
                    <span>{statusLabels[series.data.status]}</span>
                    <span aria-hidden="true">/</span>
                    <span>{String(count).padStart(2, "0")} 篇</span>
                  </p>
                  <h2>{series.data.title}</h2>
                  <p class="collection-description">{series.data.description}</p>
                </div>

                <span class="collection-action">
                  查看合集 <span class="collection-arrow" aria-hidden="true">↗</span>
                </span>
              </a>

              {seriesPosts.length > 0 && (
                <div class="collection-preview" aria-label={`${series.data.title}中的文章`}>
                  <ol>
                    {seriesPosts.slice(0, 4).map((post, postIndex) => (
                      <li>
                        <span>{String(postIndex + 1).padStart(2, "0")}</span>
                        <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                      </li>
                    ))}
                  </ol>
                </div>
              )}
            </article>
          </li>
        );
      })}
    </ol>
  </section>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .collections {
    width: min(100%, 45rem);
    margin-inline: auto;
    padding: clamp(6rem, 13vh, 9rem) 0 clamp(5rem, 9vw, 8rem);
  }

  .collection-list {
    display: flex;
    flex-direction: column;
    gap: clamp(2.35rem, 5vw, 4.25rem);
  }

  .collection-item {
    border: 0;
  }

  .collection-item article {
    position: relative;
  }

  .collection-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2.5rem;
    padding: 0;
  }

  .collection-copy {
    min-width: 0;
  }

  .collection-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 0.65rem;
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.025em;
  }

  .collection-meta span,
  .collection-preview span {
    color: inherit;
  }

  .collection-link h2 {
    margin: 0;
    font-size: clamp(1.3rem, 2vw, 1.62rem);
    font-weight: 450;
    line-height: 1.35;
    letter-spacing: -0.035em;
    transition: color 180ms ease;
  }

  .collection-description {
    display: -webkit-box;
    max-width: 36rem;
    margin: 0.55rem 0 0;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .collection-action {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .collection-arrow {
    display: inline-block;
    color: inherit;
    font-size: 1rem;
    transition: transform 180ms ease;
  }

  .collection-preview {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 300ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 180ms ease;
  }

  .collection-preview > ol {
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    list-style: none;
  }

  .collection-preview li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.9rem;
    padding-top: 0.72rem;
    border: 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .collection-preview li:first-child {
    margin-top: 0.95rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--line);
  }

  .collection-preview a {
    display: block;
    width: fit-content;
    padding: 0;
    transition: color 180ms ease;
  }

  .collection-item:hover .collection-preview,
  .collection-item:focus-within .collection-preview {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .collection-item:hover .collection-link h2,
  .collection-link:focus-visible h2,
  .collection-preview a:hover,
  .collection-preview a:focus-visible {
    color: var(--cobalt);
  }

  .collection-item:hover .collection-arrow,
  .collection-link:focus-visible .collection-arrow {
    transform: translate(0.18rem, -0.18rem);
  }

  @media (max-width: 48rem) {
    .collections {
      padding-top: 4.5rem;
    }

    .collection-link {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .collection-action {
      font-size: 0.82rem;
    }

    .collection-preview {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }
</style>
