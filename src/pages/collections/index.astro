---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, postsInSeries } from "../../lib/content";

const [seriesEntries, posts] = await Promise.all([getCollection("series"), getPublishedPosts()]);
---

<BaseLayout title="合集" description="按主题连续阅读 Kklyee.dev 的技术文章。">
  <header class="page-heading"><p>COLLECTIONS</p><h1>合集</h1></header>
  <ol class="collection-list">
    {seriesEntries.map((series) => {
      const count = postsInSeries(posts, series.id).length;
      return (
        <li>
          <a href={`/collections/${series.id}/`}>
            <div><h2>{series.data.title}</h2><p>{series.data.description}</p></div>
            <span>{String(count).padStart(2, "0")} 篇 →</span>
          </a>
        </li>
      );
    })}
  </ol>
</BaseLayout>
