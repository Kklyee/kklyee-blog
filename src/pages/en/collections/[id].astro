---
import { getCollection } from "astro:content";
import CollectionPage from "../../../components/pages/CollectionPage.astro";

export async function getStaticPaths() {
  const entries = await getCollection("series");
  return entries.map((series) => ({ params: { id: series.id }, props: { series } }));
}

const { series } = Astro.props;
---

<CollectionPage locale="en" series={series} />
