---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/posts/PostList.astro";
import { getPublishedPosts, getSeriesMap } from "../../lib/content";

const posts = await getPublishedPosts();
const seriesMap = await getSeriesMap();
---

<BaseLayout title="文章归档" description="Kklyee.dev 的全部文章。">
  <header class="page-heading"><p>ARCHIVE</p><h1>文章归档</h1></header>
  <PostList posts={posts} seriesMap={seriesMap} />
</BaseLayout>
