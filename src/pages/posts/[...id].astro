---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getPublishedPosts, postSeriesId, postsInSeries } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const seriesId = postSeriesId(post);
const seriesPosts = seriesId ? postsInSeries(await getPublishedPosts(), seriesId) : [];
const seriesIndex = seriesPosts.findIndex(({ id }) => id === post.id);
const previousPost = seriesIndex > 0 ? seriesPosts[seriesIndex - 1] : undefined;
const nextPost = seriesIndex >= 0 ? seriesPosts[seriesIndex + 1] : undefined;
---

<ArticleLayout
  {...post.data}
  headings={headings}
  previousPost={previousPost && { id: previousPost.id, title: previousPost.data.title }}
  nextPost={nextPost && { id: nextPost.id, title: nextPost.data.title }}
>
  <Content />
</ArticleLayout>
