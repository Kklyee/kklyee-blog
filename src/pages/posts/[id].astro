---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getPublishedPosts, postsInSeries } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const seriesPosts =
  post.data.series && post.data.seriesOrder
    ? postsInSeries(await getPublishedPosts(), post.data.series).filter(
        ({ data }) => data.seriesOrder !== undefined,
      )
    : [];
const seriesIndex = seriesPosts.findIndex(({ id }) => id === post.id);
const previousPost = seriesIndex > 0 ? seriesPosts[seriesIndex - 1] : undefined;
const nextPost = seriesIndex >= 0 ? seriesPosts[seriesIndex + 1] : undefined;
---

<ArticleLayout
  {...post.data}
  postId={post.id}
  headings={headings}
  previousPost={previousPost && { id: previousPost.id, title: previousPost.data.title }}
  nextPost={nextPost && { id: nextPost.id, title: nextPost.data.title }}
>
  <Content />
</ArticleLayout>
